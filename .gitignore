.streamlit/

# === Secrets / env files ===
.env
.env.*
secrets.json
credentials.json

# === Data & large artifacts ===
# By default ignore generated binary artifacts and large data. If you want to track CSVs, remove the data/ lines below.
data/*.parquet
data/*.pkl
data/*.sqlite
# Uncomment to ignore CSVs too (recommended for large generated files)
# data/*.csv

# === Images / screenshots (optional) ===
# If you add example screenshots to the repo for README, remove this line
assets/screenshots/

# === Misc ===
node_modules/
dist/

# Editor swap / temp files
*~
# vim swap
.swp

# Allow users to keep their own overrides
!.gitignore
