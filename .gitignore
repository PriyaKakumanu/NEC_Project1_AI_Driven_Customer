# === Python related ===
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
pip-wheel-metadata/
*.whl

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# === Virtual environments ===
# Common names for virtualenvs
venv/
ENV/
env/
.venv/
venv.bak/

# pyenv
.python-version

# === IDEs / Editors ===
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# === OS files ===
.DS_Store
Thumbs.db
desktop.ini

# === Logs / Databases / caches ===
*.log
*.sqlite3
.pytest_cache/
.mypy_cache/
.cache/
.coverage
coverage.xml
htmlcov/
tox/
nose2-junit-report.xml

# === Jupyter ===
